.npmrc
# LCDD self-governance Registry is version-controlled. Operational data stays local.
.lcdd/*
!.lcdd/config.yaml
!.lcdd/README.md
!.lcdd/pack.yaml
!.lcdd/contexts/
.lcdd/contexts/*
!.lcdd/contexts/hardened/
!.lcdd/contexts/local/
!.lcdd/contexts/experimental/
!.lcdd/contexts/hardened/*.yaml
!.lcdd/contexts/local/*.yaml
!.lcdd/contexts/experimental/*.yaml
.lcdd/sources/
.lcdd/snapshots/
.lcdd/discovery/
.snowflake/

# Local AI tool config (dev-only, generated by opencraft-skills)
.claude/
.codex/
.cursor/
.continue/
.zed/
.opencode/
.windsurf/
.aider/
.github/copilot/

node_modules/
dist/
implementation/.artifacts/
*.log
!.lcdd/contexts/.events.log
.DS_Store
