---
import Base from '../layouts/Base.astro';
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/favicon.png" alt="LCDD" width="26" height="26" style="border-radius:6px;background:var(--b);border:1px solid #fff;;padding:2px;" />
        LCDD
      </a>
      <div class="nav-links" id="nav-links">
        <a href="#context">Context</a>
        <a href="#governance">Governance</a>
        <a href="#best-practice">Setup</a>
        <a href="#start">Start</a>
        <a href="https://github.com/Lelianto/living-context-driven-development" class="btn btn-stroke" style="font-size:12px;padding:4px 14px;">GitHub</a>
      </div>
      <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu" style="display:none;background:none;border:none;color:var(--s5);font-size:22px;cursor:pointer;padding:4px;">
        &#9776;
      </button>
    </div>
  </nav>

  <section class="hero">
    <div class="content">
      <div style="display:inline-block;padding:6px;background:var(--b);border:1px solid #fff;;border-radius:clamp(14px,2vw,20px);margin-bottom:28px;">
        <img src="/logo.png" alt="LCDD" style="width:clamp(64px,12vw,120px);height:auto;display:block;border-radius:clamp(8px,1vw,12px);" />
      </div>
      <div style="margin-bottom:12px;">
        <span class="badge badge-fill">Spec v0.4.0</span>
        <span class="badge badge-stroke" style="margin-left:6px;">Impl v0.6.0</span>
      </div>
      <h1>Living Context Driven Development</h1>
      <p class="tagline">Living Context is the continuously evolving representation of project knowledge.</p>
      <p class="desc">
        Documentation dies. Specifications drift. Knowledge changes. Yet AI keeps coding as if nothing happened.<br>
        LCDD treats context as a living artifact — versioned, governed, enforced, and evolved.
      </p>
      <div class="actions">
        <a href="#start" class="btn btn-fill">Get Started</a>
        <a href="https://github.com/Lelianto/living-context-driven-development" class="btn btn-stroke">GitHub</a>
        <a href="https://www.npmjs.com/package/@lcdd/cli" class="btn btn-stroke">npm i @lcdd/cli</a>
      </div>
    </div>
  </section>

  <!-- WHAT -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">The Problem</p>
        <h2 class="h2">AI writes code faster than humans can govern it.</h2>
        <p class="sub">
          When an AI agent faces a failing test, it sometimes rewrites the assertion instead of fixing
          the code. When a new regulation is published, nobody notices for months. When an architectural
          decision is made in a Slack thread, it's forgotten by everyone except the person who wrote it.
          <br /><br />
          LCDD makes every rule, constraint, and piece of governance knowledge a first-class artifact
          &mdash; versioned, structured, machine-readable, and enforceable.
        </p>
      </div>

      <div class="triple reveal" style="margin-top:56px;">
        <div class="feature">
          <h4>Discovery Pipeline</h4>
          <p>Nine stages from source detection to continuous improvement. Ingest regulations from PDFs, standards from wikis, decisions from Slack.</p>
        </div>
        <div class="feature">
          <h4>Context Lifecycle</h4>
          <p>Six explicit stages: Draft to Archived. Each has defined enforcement behavior, review requirements, and observability expectations.</p>
        </div>
        <div class="feature">
          <h4>Spec Drift Prevention</h4>
          <p>AI agents cannot modify Hardened contexts. Violations are attributed to human or AI actor. Patterns trigger governance review.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTEXT -->
  <section id="context" class="section alt">
    <div class="wrap">
      <div class="split reveal">
        <div>
          <p class="label">The Context</p>
          <h2 class="h2">Every rule becomes a structured artifact.</h2>
          <p style="color:var(--s5);font-size:15px;line-height:1.6;">
            A Context is not a comment, not a ticket, not a Slack message. It is a versioned YAML file
            that answers: what the rule is, who says so, why trust them, where it applies, and how it's enforced.
          </p>
          <p style="color:var(--s5);font-size:15px;line-height:1.6;margin-top:16px;">
            Because every Context follows the same schema, CI can parse it, AI agents can consume it,
            dashboards can query it, and auditors can trace it from source to enforcement.
          </p>
        </div>
        <div>
          <pre style="margin:0;"><code>id: "ctx-no-secrets"
version: 3
title: "Secrets MUST NOT be in source"

source:
  type: "incident"
  uri: "https://incidents.example.com"

authority:
  source:
    type: "organization"
    name: "Security Team"
  level: 3    # org-wide policy

lifecycle: "active"

governance:
  classification: "hardened-standard"
  approval_required: true

enforcement:
  mode: "block"
  specification:
    type: "regex-pattern"
    config:
      patterns:
        - "(?i)(api_key|secret)"
      should_not_match: true</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- LIFECYCLE -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Lifecycle</p>
        <h2 class="h2">Every rule has a journey.</h2>
        <p class="sub">
          Constraints don't jump from &ldquo;someone mentioned this&rdquo; to &ldquo;this blocks production.&rdquo;
          Each stage has defined enforcement, review, and observability.
        </p>
      </div>

      <div class="lifecycle-row reveal">
        {[
          ['Draft', 'Discovered. Visible but never enforced.', 'var(--s4)'],
          ['Candidate', 'Under review. Comment-only.', 'var(--s5)'],
          ['Approved', 'Approved. Migration window. Warn mode.', 'var(--gd)'],
          ['Active', 'Fully enforced. Block or Warn.', 'var(--g)'],
          ['Deprecated', 'No longer applies. Warn with notice.', 'var(--s5)'],
          ['Archived', 'Retained for audit. Immutable.', 'var(--s4)'],
        ].map(([name, desc, color], i) => (
          <div class="lc-stage" style={`animation-delay:${i * 80}ms`}>
            <div class="lc-num" style={`background:${color};color:var(--b);`}>{i + 1}</div>
            <div class="lc-name">{name}</div>
            <div class="lc-desc">{desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GOVERNANCE -->
  <section id="governance" class="section alt">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Governance</p>
        <h2 class="h2">Not all rules are equal.</h2>
        <p class="sub">
          Governance scales with impact. Hardened contexts require explicit human approval.
          Local contexts can evolve through AI suggestion and fitness-based optimization.
        </p>

        <table>
          <thead>
            <tr><th>Classification</th><th>Authority</th><th>AI Can Modify?</th><th>Enforcement</th></tr>
          </thead>
          <tbody>
            <tr><td style="color:var(--w);font-weight:500;">Hardened-Mandate</td><td>4</td><td><span class="no">Never</span></td><td><span style="color:var(--g);">Block</span></td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Hardened-Standard</td><td>3</td><td><span class="no">Never</span></td><td><span style="color:var(--g);">Block</span></td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Hardened-Local</td><td>2</td><td><span style="color:var(--s5);">Suggest only</span></td><td>Warn</td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Local-Standard</td><td>2</td><td><span style="color:var(--s6);">With review</span></td><td>Warn</td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Local-Guideline</td><td>1</td><td><span class="yes">Auto-merge</span></td><td>Comment</td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Local-Experimental</td><td>0</td><td><span class="yes">Primary source</span></td><td>Silent</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Comparison</p>
        <h2 class="h2">What LCDD does that nothing else does.</h2>
        <p class="sub">
          LCDD is not a replacement for TDD, DDD, or existing tools. It fills a governance gap
          none of them address &mdash; discovering, managing, and enforcing constraints from any source.
        </p>

        <table>
          <thead>
            <tr><th></th><th>TDD</th><th>DDD</th><th>CDD Tools</th><th>AI Harness</th><th style="color:var(--g);">LCDD</th></tr>
          </thead>
          <tbody>
            <tr><td>Governs</td><td>Code behavior</td><td>Domain model</td><td>AI workflow</td><td>Integrity</td><td style="color:var(--gb);font-weight:500;">All sources</td></tr>
            <tr><td>Discovery</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Pipeline</td></tr>
            <tr><td>Lifecycle</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td>Binary</td><td class="yes">6-stage</td></tr>
            <tr><td>AI-Aware</td><td class="no">No</td><td class="no">No</td><td>Workflow</td><td class="yes">Yes</td><td class="yes">Built-in</td></tr>
            <tr><td>Drift Prevention</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Yes</td><td class="yes">Yes</td></tr>
            <tr><td>Observability</td><td>Tests</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Full</td></tr>
            <tr><td>Context Packs</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Yes</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- DISCOVERY PIPELINE -->
  <section class="section alt">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Discovery Pipeline</p>
        <h2 class="h2">From unknown to enforced.</h2>
        <p class="sub">
          The core novelty of LCDD — a nine-stage pipeline that discovers constraints
          from any source, not just known ones. <span style="font-size:12px;color:var(--g);">(Stages 01 &amp; 04–09 done, 02–03 Phase A)</span>
        </p>
      </div>

      <div class="pipeline-grid reveal" id="pipeline-grid"></div>
      <p style="text-align:center;margin-top:20px;font-size:11px;color:var(--s5);">
        <span style="color:var(--g);">● done</span> &nbsp;·&nbsp;
        <span style="color:#f59e0b;">● wip</span> &nbsp;·&nbsp;
        <span style="color:var(--s4);">● planned</span>
      </p>
    </div>
  </section>

  <!-- MODAL -->
  <div class="modal-overlay" id="modal">
    <div class="modal-box">
      <button class="modal-close" id="modal-close">&times;</button>
      <div class="modal-num" id="modal-num"></div>
      <div class="modal-title" id="modal-title"></div>
      <div class="modal-desc" id="modal-desc"></div>
      <div class="modal-detail" id="modal-detail"></div>
    </div>
  </div>

  <!-- BEST PRACTICE ONBOARDING -->
  <section id="best-practice" class="section setup-section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Best Practice · Existing Projects</p>
        <h2 class="h2">Adopt governance gradually. Earn the right to block.</h2>
        <p class="sub">Start by making existing knowledge visible, not by turning every rule into a merge blocker. This five-step rollout keeps delivery moving while your team builds trustworthy Contexts.</p>
      </div>

      <div class="setup-lab reveal" id="setup-lab">
        <ol class="setup-steps" aria-label="Recommended LCDD setup sequence">
          {[
            ['01', 'Install & initialize', 'Create the local Registry. Commit its structure with the project.'],
            ['02', 'Inventory real rules', 'Start from ADRs, CI, security policy, and recurring review feedback.'],
            ['03', 'Draft, don’t block', 'Capture a small first set. Keep uncertain knowledge Local and reviewable.'],
            ['04', 'Validate in warn mode', 'Run locally and in CI. Observe false positives before raising enforcement.'],
            ['05', 'Promote with evidence', 'Activate stable rules; use strict mode only for proven Hardened constraints.'],
          ].map(([num, title, description], index) => (
            <li><button class="setup-step" type="button" data-setup-step={index} aria-pressed={index === 0 ? 'true' : 'false'}>
              <span class="setup-number">{num}</span><span><strong>{title}</strong><small>{description}</small></span>
            </button></li>
          ))}
        </ol>

        <div class="setup-terminal" aria-live="polite">
          <div class="terminal-bar"><span></span><span></span><span></span><p>existing-project — LCDD onboarding</p></div>
          <div class="terminal-body">
            <div class="setup-panel active" data-setup-panel="0">
              <p class="terminal-kicker">Step 01 · Foundation</p>
              <pre><code>cd your-existing-project
npm install --save-dev @lcdd/cli
npx lcd init
npx lcd setup ci --provider github --yes
git add .lcdd/ .github/workflows/lcdd.yml package.json package-lock.json</code></pre>
              <p class="terminal-note">✓ Registry structure becomes part of the project—not private agent memory.</p>
            </div>
            <div class="setup-panel" data-setup-panel="1">
              <p class="terminal-kicker">Step 02 · Evidence first</p>
              <div class="source-list"><span>ADR & architecture docs</span><span>CI & test policy</span><span>Security requirements</span><span>Repeated review corrections</span></div>
              <p class="terminal-note">Choose 3–5 high-value constraints with a named owner and traceable source.</p>
            </div>
            <div class="setup-panel" data-setup-panel="2">
              <p class="terminal-kicker">Step 03 · Govern the uncertainty</p>
              <pre><code>npx lcd context add
# lifecycle: draft → candidate
# classification: local-guideline
# enforcement: comment or warn</code></pre>
              <p class="terminal-note">Never infer Hardened authority just because a rule sounds important.</p>
            </div>
            <div class="setup-panel" data-setup-panel="3">
              <p class="terminal-kicker">Step 04 · Observe before enforcement</p>
              <pre><code>npx lcd validate
npx lcd doctor
npx lcd setup ci --provider github --yes</code></pre>
              <p class="terminal-note">Review scope, ownership, and false positives with the people affected.</p>
            </div>
            <div class="setup-panel" data-setup-panel="4">
              <p class="terminal-kicker">Step 05 · Evidence-backed enforcement</p>
              <pre><code>npx lcd transition &lt;context-id&gt; approved
npx lcd transition &lt;context-id&gt; active
# CI after confidence is earned:
npx lcd validate --strict</code></pre>
              <p class="terminal-note">✓ Hardened promotion remains an explicit human decision with an audit trail.</p>
            </div>
          </div>
          <div class="setup-progress" aria-hidden="true"><span id="setup-progress-bar"></span></div>
        </div>
      </div>

      <div class="setup-principles reveal">
        <p><strong>Small first pack</strong><span>Prefer 3–5 useful Contexts over importing every document.</span></p>
        <p><strong>Source + owner required</strong><span>A constraint without provenance cannot earn stronger authority.</span></p>
        <p><strong>Warn before block</strong><span>Promote enforcement only after real usage produces evidence.</span></p>
      </div>
    </div>
  </section>

  <!-- GET STARTED -->
  <section id="start" class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Get Started</p>
        <h2 class="h2">Install. Create. Validate.</h2>
      </div>

      <div class="split reveal" style="margin-top:40px;">
        <div>
          <p style="font-size:15px;font-weight:500;color:var(--w);margin-bottom:12px;">Install the CLI & MCP</p>
          <div class="yarn">npm install -g @lcdd/cli @lcdd/mcp</div>
          <div class="yarn">lcd init<br/>lcd context add<br/>lcd validate<br/>lcd doctor<br/>lcd setup ci --provider github --yes</div>
          <p style="font-size:13px;color:var(--s5);margin-top:8px;">
            Also on <a href="https://github.com/Lelianto/living-context-driven-development/pkgs/npm/lcdd-cli">GitHub Packages</a>.
          </p>
        </div>
        <div>
          <p style="font-size:15px;font-weight:500;color:var(--w);margin-bottom:12px;">Validate in CI</p>
          <div class="yarn">lcd setup ci --provider github --dry-run<br/>lcd setup ci --provider github --yes</div>
          <p style="font-size:13px;color:var(--s5);margin-top:8px;margin-bottom:12px;">
            Commit the generated workflow. After its first successful run, require LCDD / validate in the default-branch ruleset.
          </p>
          <div class="yarn"># generated safely and idempotently
git add .github/workflows/lcdd.yml
git commit -m "ci: enable LCDD"</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section alt">
    <div class="wrap">
      <p class="label">Ecosystem</p>
      <div class="quad reveal" style="margin-top:32px;">
        <a href="https://www.npmjs.com/package/@lcdd/core" class="feature" style="text-decoration:none;color:inherit;">
          <h4>@lcdd/core</h4>
          <p>SDK — Context model, schema, registry, CQL, verifier, doctor, rule engine, extractor, normalizer.</p>
        </a>
        <a href="https://www.npmjs.com/package/@lcdd/cli" class="feature" style="text-decoration:none;color:inherit;">
          <h4>@lcdd/cli</h4>
          <p>CLI — init, context, validate, query, doctor, review, source, extract, normalize, dashboard.</p>
        </a>
        <a href="https://www.npmjs.com/package/@lcdd/mcp" class="feature" style="text-decoration:none;color:inherit;">
          <h4>@lcdd/mcp</h4>
          <p>MCP Server — 8 tools for Claude, Cursor, Cline. AI agents query, validate, and inspect governance recommendations.</p>
        </a>
        <div class="feature">
          <h4>Context Packs</h4>
          <p>5 domains — Startup, Fintech (OJK), Healthcare (HIPAA), E-commerce, Education.</p>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-inner">
        <div>
          <div class="footer-name">Living Context Driven Development</div>
          <div class="footer-meta">v0.6.0 &middot; Apache 2.0</div>
        </div>
        <div class="footer-links">
          <a href="https://github.com/Lelianto/living-context-driven-development">GitHub</a>
          <a href="https://www.npmjs.com/package/@lcdd/cli">npm</a>
          <a href="https://github.com/Lelianto/living-context-driven-development/blob/main/lcdd-methodology.md">Methodology</a>
          <a href="https://github.com/Lelianto/living-context-driven-development/tree/main/specification">Specification</a>
        </div>
      </div>
    </div>
  </footer>
</Base>

<script>
  const steps = [
    { num: '01', name: 'Discover', desc: 'Monitor sources — Git, web, RSS. Scheduled or real-time.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.4.0)</strong><br/><br/><strong>Purpose:</strong> Detect new or changed constraints from registered sources.<br/><br/><strong>Implemented:</strong> <code>lcd source add</code> to register Git repos and websites. <code>lcd source watch</code> for continuous polling. <code>lcd source schedule</code> to generate cron or GitHub Actions configs. Git connector uses clone+fetch+diff. Website connector uses HTTP GET+SHA-256 checksum. Change events persisted to <code>.lcdd/sources/.changes.log</code>.<br/><br/><strong>CLI:</strong> <code>lcd source add &lt;url&gt;</code>, <code>lcd source watch --interval 60</code>, <code>lcd source schedule --github</code>.<br/><br/><strong>Future:</strong> RSS/Slack/PDF connectors, LLM relevance scoring (v1.0+).' },
    { num: '02', name: 'Extract', desc: 'LLM parses documents into candidate constraints.',
      status: 'partial',
      detail: '<strong>Status: Phase A (v0.4.0)</strong><br/><br/><strong>Purpose:</strong> Transform raw source content into structured candidate Contexts.<br/><br/><strong>Implemented:</strong> <code>lcd extract &lt;source-id&gt;</code>. Three LLM backends: <strong>Ollama</strong> (free, local, no API key — default), <strong>OpenAI</strong> (GPT-4o-mini, requires OPENAI_API_KEY), <strong>Anthropic</strong> (Claude Haiku, requires ANTHROPIC_API_KEY). Structured prompt with JSON output schema. Confidence scoring per extraction (0.0–1.0). <code>--dry-run</code> and <code>--auto</code> modes.<br/><br/><strong>Future:</strong> Streaming extraction, batch processing, local embedding models (v1.0+).' },
    { num: '03', name: 'Normalize', desc: 'Schema map. Jaccard dedup. Validate.',
      status: 'partial',
      detail: '<strong>Status: Phase A (v0.4.0)</strong><br/><br/><strong>Purpose:</strong> Map extracted candidates to the full LCDD Context Schema with deduplication.<br/><br/><strong>Implemented:</strong> <code>lcd normalize</code>. Schema mapping with ID generation (UUID). RuleEngine defaults (authority, governance, severity, tags). JSON Schema validation. SHA-256 exact-match dedup. Jaccard similarity for near-duplicate detection (threshold 0.8). Confidence filtering (skip < 0.5). Auto-writes valid candidates as draft contexts to registry.<br/><br/><strong>Future:</strong> Embedding-based dedup with cosine similarity, cross-lingual dedup (v1.0+).' },
    { num: '04', name: 'Classify', desc: 'Auto-assign authority, severity, tags via rules.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.3.0)</strong><br/><br/><strong>Purpose:</strong> Assign lifecycle stage, authority level, governance classification, domain tags, and enforcement mode.<br/><br/><strong>Deterministic rules:</strong> Source type → authority level (standard-body=4, regulatory=4, organization=3, community=2, individual=1). Authority → governance classification. Keyword analysis → severity (must/shall/critical→critical, should/important→high). Domain keywords → tags. User can override all suggestions.<br/><br/><strong>CLI:</strong> Integrated into <code>lcd context add</code> — shows suggestions, asks for confirmation.' },
    { num: '05', name: 'Review', desc: 'Approve, reject, revision. Auto-approve for Local.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.3.0)</strong><br/><br/><strong>Purpose:</strong> Human and automated review of contexts before they become enforceable.<br/><br/><strong>Implemented:</strong> <code>lcd review list</code> (pending reviews), <code>lcd review show &lt;id&gt;</code> (side-by-side source vs context), <code>lcd review approve/reject/revision &lt;id&gt;</code>. Auto-approval for Local contexts with high confidence. Review workflow integrated with lifecycle transitions.<br/><br/><strong>CLI:</strong> <code>lcd review list</code>, <code>lcd review approve &lt;id&gt; --reason "..."</code>, <code>lcd review auto-approve</code>.' },
    { num: '06', name: 'Version', desc: 'Commit immutable version. Audit trail.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.2.1)</strong><br/><br/><strong>Purpose:</strong> Commit the approved Context to the Registry with an immutable version number.<br/><br/><strong>Process:</strong> Final schema validation, conflict detection against existing Active contexts, version assignment (version 1 for new, current + 1 for updates), immutable commit to the Registry, event emission.<br/><br/><strong>Output:</strong> Versioned Context in the Registry — immutable, auditable, with complete event log (JSON Lines in .lcdd/contexts/.events.log).<br/><br/><strong>CLI:</strong> <code>lcd context add</code>, <code>lcd transition</code>.' },
    { num: '07', name: 'Enforce', desc: 'CI, IDE, gateway, AI agent — pluggable.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.2.1)</strong><br/><br/><strong>Purpose:</strong> Consume Active contexts through enforcement plugins and report violations.<br/><br/><strong>Plugins:</strong> CI/CD pipeline (block merges), IDE (real-time violation highlighting), pre-commit hooks (fast local checks), API gateway (runtime validation), Terraform plan (infrastructure compliance), AI agent prompts (context injection).<br/><br/><strong>Modes:</strong> Block (prevents progression), Warn (visible warning), Comment (informational), Silent (tracked only). Mode determined by governance classification and lifecycle stage.<br/><br/><strong>CLI:</strong> <code>lcd validate</code>, <code>lcd validate --strict</code>. Built-in verifiers: regex-pattern, file-exists. Extensible via <code>verifier.register()</code>.' },
    { num: '08', name: 'Observe', desc: 'Dashboard, metrics, violation trends.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.3.0)</strong><br/><br/><strong>Purpose:</strong> Collect and analyze enforcement outcomes to close the feedback loop.<br/><br/><strong>Implemented:</strong> <code>lcd dashboard</code> — terminal report with violation trends (7d/30d/90d), actor breakdown (human vs AI agent), top violated contexts, enforcement mode distribution, lifecycle velocity. <code>lcd dashboard --web</code> — interactive Chart.js dashboard at localhost:9321 with API endpoint <code>/api/metrics</code>. Enforcement events persisted to <code>.lcdd/contexts/.enforcements.log</code>.<br/><br/><strong>CLI:</strong> <code>lcd dashboard</code>, <code>lcd dashboard --web</code>, <code>lcd dashboard --web --port 3000</code>.' },
    { num: '09', name: 'Improve', desc: 'Health score, triggers, self-healing loop.',
      status: 'done',
      detail: '<strong>Status: Implemented (v0.5.0)</strong><br/><br/><strong>Purpose:</strong> Use observation data to drive context evolution.<br/><br/><strong>Implemented:</strong> <code>lcd doctor</code> — Context Health Score (0–100) with letter grade (A–F). Eight health metrics: Stale Contexts, Missing Owners, Enforcement Conflicts, Deprecation Backlog, Draft Stagnation, Authority Gaps, Tag Hygiene, Review Backlog. Six deterministic triggers: STALE_NO_VIOLATION, HIGH_VIOLATION_RATE, HIGH_FALSE_POSITIVE, INCREASING_VIOLATIONS, AI_DRIFT, NEW_SOURCE_DETECTED.<br/><br/><strong>Self-healing loop (v0.5.0):</strong> <code>lcd improve check</code> lists guardrail-gated recommendations, <code>lcd improve apply &lt;id&gt;</code> applies safe ones (deprecate, refine-scope, register-source) with snapshot + health verification + automatic rollback on regression, <code>lcd improve rollback &lt;heal-id&gt;</code> restores the pre-heal state. Nine guardrails: hardened contexts never auto-modified, low-confidence routes to humans, every action audited, never reduce health.<br/><br/><strong>CLI:</strong> <code>lcd doctor</code>, <code>lcd doctor --triggers</code>, <code>lcd improve check</code>, <code>lcd improve apply &lt;id&gt; --dry-run</code>, <code>lcd improve rollback &lt;heal-id&gt;</code>.' },
  ];

  const grid = document.getElementById('pipeline-grid');
  if (grid) {
    steps.forEach((s, i) => {
      const el = document.createElement('div');
      el.className = 'pipeline-step';
      el.style.animationDelay = `${i * 50}ms`;
      const badge = s.status === 'done'
        ? '<span style="font-size:10px;font-weight:500;color:var(--g);border:1px solid var(--g);padding:1px 6px;border-radius:10px;margin-left:6px;">done</span>'
        : s.status === 'partial'
        ? '<span style="font-size:10px;font-weight:500;color:#f59e0b;border:1px solid #f59e0b;padding:1px 6px;border-radius:10px;margin-left:6px;">wip</span>'
        : '<span style="font-size:10px;font-weight:500;color:var(--s5);border:1px solid var(--s4);padding:1px 6px;border-radius:10px;margin-left:6px;">planned</span>';
      el.innerHTML = `<div class="num">${s.num}${badge}</div><div class="name">${s.name}</div><div class="desc">${s.desc}</div>`;
      el.addEventListener('click', () => openModal(i));
      grid.appendChild(el);
    });
  }

  const modal = document.getElementById('modal');
  const modalNum = document.getElementById('modal-num');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalDetail = document.getElementById('modal-detail');
  const modalClose = document.getElementById('modal-close');

  function openModal(i: number) {
    const s = steps[i];
    if (modalNum) modalNum.textContent = `Stage ${s.num}`;
    if (modalTitle) modalTitle.textContent = s.name;
    if (modalDesc) modalDesc.textContent = s.desc;
    if (modalDetail) modalDetail.innerHTML = s.detail;
    modal?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.remove('active');
    document.body.style.overflow = '';
  }

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Hamburger menu
  const hamburger = document.getElementById('nav-hamburger');
  const navLinks = document.getElementById('nav-links');
  hamburger?.addEventListener('click', () => {
    navLinks?.classList.toggle('open');
    hamburger.textContent = navLinks?.classList.contains('open') ? '\u2715' : '\u2630';
  });
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      if (hamburger) hamburger.textContent = '\u2630';
    });
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  const setupLab = document.getElementById('setup-lab');
  const setupButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-setup-step]'));
  const setupPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-setup-panel]'));
  const setupProgress = document.getElementById('setup-progress-bar');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let setupIndex = 0;
  let setupTimer: number | undefined;

  function showSetupStep(index: number, userInitiated = false) {
    setupIndex = index;
    setupButtons.forEach((button, i) => {
      button.classList.toggle('active', i === index);
      button.setAttribute('aria-pressed', String(i === index));
    });
    setupPanels.forEach((panel, i) => panel.classList.toggle('active', i === index));
    if (setupProgress) {
      setupProgress.style.animation = 'none';
      setupProgress.style.width = `${((index + 1) / setupButtons.length) * 100}%`;
      if (!reducedMotion && !userInitiated) requestAnimationFrame(() => {
        setupProgress.style.animation = 'setupTick 4.5s linear forwards';
      });
    }
    if (userInitiated && setupTimer) {
      window.clearInterval(setupTimer);
      setupTimer = undefined;
    }
  }

  setupButtons.forEach((button, index) => button.addEventListener('click', () => showSetupStep(index, true)));
  if (setupLab && !reducedMotion) {
    const setupObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !setupTimer) {
        showSetupStep(setupIndex);
        setupTimer = window.setInterval(() => showSetupStep((setupIndex + 1) % setupButtons.length), 4500);
      } else if (!entry.isIntersecting && setupTimer) {
        window.clearInterval(setupTimer);
        setupTimer = undefined;
      }
    }, { threshold: 0.35 });
    setupObserver.observe(setupLab);
  } else {
    showSetupStep(0, true);
  }
</script>

<style>
  @keyframes lcPulse {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>
