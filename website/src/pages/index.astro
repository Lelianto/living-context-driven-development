---
import Base from '../layouts/Base.astro';
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/favicon.png" alt="LCDD" width="26" height="26" style="border-radius:6px;background:var(--b);border:1px solid #fff;;padding:2px;" />
        LCDD
      </a>
      <div class="nav-links" id="nav-links">
        <a href="#context">Context</a>
        <a href="#governance">Governance</a>
        <a href="#start">Start</a>
        <a href="https://github.com/Lelianto/living-context-driven-development" class="btn btn-stroke" style="font-size:12px;padding:4px 14px;">GitHub</a>
      </div>
      <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu" style="display:none;background:none;border:none;color:var(--s5);font-size:22px;cursor:pointer;padding:4px;">
        &#9776;
      </button>
    </div>
  </nav>

  <section class="hero">
    <div class="content">
      <div style="display:inline-block;padding:6px;background:var(--b);border:1px solid #fff;;border-radius:clamp(14px,2vw,20px);margin-bottom:28px;">
        <img src="/logo.png" alt="LCDD" style="width:clamp(64px,12vw,120px);height:auto;display:block;border-radius:clamp(8px,1vw,12px);" />
      </div>
      <div style="margin-bottom:12px;">
        <span class="badge badge-fill">Spec v0.2.1</span>
        <span class="badge badge-stroke" style="margin-left:6px;">Impl v0.2.1</span>
      </div>
      <h1>Living Context Driven Development</h1>
      <p class="tagline">Discover. Govern. Enforce. Observe.</p>
      <p class="desc">
        An open specification and methodology for discovering, managing, and enforcing
        the constraints that govern AI-assisted software development.
      </p>
      <div class="actions">
        <a href="#start" class="btn btn-fill">Get Started</a>
        <a href="https://github.com/Lelianto/living-context-driven-development" class="btn btn-stroke">GitHub</a>
        <a href="https://www.npmjs.com/package/@lcdd/cli" class="btn btn-stroke">npm i @lcdd/cli</a>
      </div>
    </div>
  </section>

  <!-- WHAT -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">The Problem</p>
        <h2 class="h2">AI writes code faster than humans can govern it.</h2>
        <p class="sub">
          When an AI agent faces a failing test, it sometimes rewrites the assertion instead of fixing
          the code. When a new regulation is published, nobody notices for months. When an architectural
          decision is made in a Slack thread, it's forgotten by everyone except the person who wrote it.
          <br /><br />
          LCDD makes every rule, constraint, and piece of governance knowledge a first-class artifact
          &mdash; versioned, structured, machine-readable, and enforceable.
        </p>
      </div>

      <div class="triple reveal" style="margin-top:56px;">
        <div class="feature">
          <h4>Discovery Pipeline</h4>
          <p>Nine stages from source detection to continuous improvement. Ingest regulations from PDFs, standards from wikis, decisions from Slack.</p>
        </div>
        <div class="feature">
          <h4>Context Lifecycle</h4>
          <p>Six explicit stages: Draft to Archived. Each has defined enforcement behavior, review requirements, and observability expectations.</p>
        </div>
        <div class="feature">
          <h4>Spec Drift Prevention</h4>
          <p>AI agents cannot modify Hardened contexts. Violations are attributed to human or AI actor. Patterns trigger governance review.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTEXT -->
  <section id="context" class="section alt">
    <div class="wrap">
      <div class="split reveal">
        <div>
          <p class="label">The Context</p>
          <h2 class="h2">Every rule becomes a structured artifact.</h2>
          <p style="color:var(--s5);font-size:15px;line-height:1.6;">
            A Context is not a comment, not a ticket, not a Slack message. It is a versioned YAML file
            that answers: what the rule is, who says so, why trust them, where it applies, and how it's enforced.
          </p>
          <p style="color:var(--s5);font-size:15px;line-height:1.6;margin-top:16px;">
            Because every Context follows the same schema, CI can parse it, AI agents can consume it,
            dashboards can query it, and auditors can trace it from source to enforcement.
          </p>
        </div>
        <div>
          <pre style="margin:0;"><code>id: "ctx-no-secrets"
version: 3
title: "Secrets MUST NOT be in source"

source:
  type: "incident"
  uri: "https://incidents.example.com"

authority:
  source:
    type: "organization"
    name: "Security Team"
  level: 3    # org-wide policy

lifecycle: "active"

governance:
  classification: "hardened-standard"
  approval_required: true

enforcement:
  mode: "block"
  specification:
    type: "regex-pattern"
    config:
      patterns:
        - "(?i)(api_key|secret)"
      should_not_match: true</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- LIFECYCLE -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Lifecycle</p>
        <h2 class="h2">Every rule has a journey.</h2>
        <p class="sub">
          Constraints don't jump from &ldquo;someone mentioned this&rdquo; to &ldquo;this blocks production.&rdquo;
          Each stage has defined enforcement, review, and observability.
        </p>
      </div>

      <div class="lifecycle-row reveal">
        {[
          ['Draft', 'Discovered. Visible but never enforced.', 'var(--s4)'],
          ['Candidate', 'Under review. Comment-only.', 'var(--s5)'],
          ['Approved', 'Approved. Migration window. Warn mode.', 'var(--gd)'],
          ['Active', 'Fully enforced. Block or Warn.', 'var(--g)'],
          ['Deprecated', 'No longer applies. Warn with notice.', 'var(--s5)'],
          ['Archived', 'Retained for audit. Immutable.', 'var(--s4)'],
        ].map(([name, desc, color], i) => (
          <div class="lc-stage" style={`animation-delay:${i * 80}ms`}>
            <div class="lc-num" style={`background:${color};color:var(--b);`}>{i + 1}</div>
            <div class="lc-name">{name}</div>
            <div class="lc-desc">{desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GOVERNANCE -->
  <section id="governance" class="section alt">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Governance</p>
        <h2 class="h2">Not all rules are equal.</h2>
        <p class="sub">
          Governance scales with impact. Hardened contexts require explicit human approval.
          Local contexts can evolve through AI suggestion and fitness-based optimization.
        </p>

        <table>
          <thead>
            <tr><th>Classification</th><th>Authority</th><th>AI Can Modify?</th><th>Enforcement</th></tr>
          </thead>
          <tbody>
            <tr><td style="color:var(--w);font-weight:500;">Hardened-Mandate</td><td>4</td><td><span class="no">Never</span></td><td><span style="color:var(--g);">Block</span></td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Hardened-Standard</td><td>3</td><td><span class="no">Never</span></td><td><span style="color:var(--g);">Block</span></td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Hardened-Local</td><td>2</td><td><span style="color:var(--s5);">Suggest only</span></td><td>Warn</td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Local-Standard</td><td>2</td><td><span style="color:var(--s6);">With review</span></td><td>Warn</td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Local-Guideline</td><td>1</td><td><span class="yes">Auto-merge</span></td><td>Comment</td></tr>
            <tr><td style="color:var(--w);font-weight:500;">Local-Experimental</td><td>0</td><td><span class="yes">Primary source</span></td><td>Silent</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Comparison</p>
        <h2 class="h2">What LCDD does that nothing else does.</h2>
        <p class="sub">
          LCDD is not a replacement for TDD, DDD, or existing tools. It fills a governance gap
          none of them address &mdash; discovering, managing, and enforcing constraints from any source.
        </p>

        <table>
          <thead>
            <tr><th></th><th>TDD</th><th>DDD</th><th>CDD Tools</th><th>AI Harness</th><th style="color:var(--g);">LCDD</th></tr>
          </thead>
          <tbody>
            <tr><td>Governs</td><td>Code behavior</td><td>Domain model</td><td>AI workflow</td><td>Integrity</td><td style="color:var(--gb);font-weight:500;">All sources</td></tr>
            <tr><td>Discovery</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Pipeline</td></tr>
            <tr><td>Lifecycle</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td>Binary</td><td class="yes">6-stage</td></tr>
            <tr><td>AI-Aware</td><td class="no">No</td><td class="no">No</td><td>Workflow</td><td class="yes">Yes</td><td class="yes">Built-in</td></tr>
            <tr><td>Drift Prevention</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Yes</td><td class="yes">Yes</td></tr>
            <tr><td>Observability</td><td>Tests</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Full</td></tr>
            <tr><td>Context Packs</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="no">No</td><td class="yes">Yes</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- DISCOVERY PIPELINE -->
  <section class="section alt">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Discovery Pipeline</p>
        <h2 class="h2">From unknown to enforced.</h2>
        <p class="sub">
          The core novelty of LCDD &mdash; a nine-stage pipeline that discovers constraints
          from any source, not just known ones. Click any stage for details.
        </p>
      </div>

      <div class="pipeline-grid reveal" id="pipeline-grid"></div>
    </div>
  </section>

  <!-- MODAL -->
  <div class="modal-overlay" id="modal">
    <div class="modal-box">
      <button class="modal-close" id="modal-close">&times;</button>
      <div class="modal-num" id="modal-num"></div>
      <div class="modal-title" id="modal-title"></div>
      <div class="modal-desc" id="modal-desc"></div>
      <div class="modal-detail" id="modal-detail"></div>
    </div>
  </div>

  <!-- GET STARTED -->
  <section id="start" class="section">
    <div class="wrap">
      <div class="reveal">
        <p class="label">Get Started</p>
        <h2 class="h2">Install. Create. Validate.</h2>
      </div>

      <div class="split reveal" style="margin-top:40px;">
        <div>
          <p style="font-size:15px;font-weight:500;color:var(--w);margin-bottom:12px;">Install the CLI</p>
          <div class="yarn">npm install -g @lcdd/cli</div>
          <div class="yarn">lcd init<br/>lcd context add</div>
          <p style="font-size:13px;color:var(--s5);margin-top:8px;">
            Also on <a href="https://github.com/Lelianto/living-context-driven-development/pkgs/npm/lcdd-cli">GitHub Packages</a>.
          </p>
        </div>
        <div>
          <p style="font-size:15px;font-weight:500;color:var(--w);margin-bottom:12px;">Validate in CI</p>
          <div class="yarn">lcd validate --strict</div>
          <p style="font-size:13px;color:var(--s5);margin-top:8px;margin-bottom:12px;">
            Add to GitHub Actions. Block merges on Hardened violations.
          </p>
          <div class="yarn"># .github/workflows/ci.yml
- name: LCDD Validate
  run: npx @lcdd/cli validate --strict</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ECOSYSTEM -->
  <section class="section alt">
    <div class="wrap">
      <p class="label">Ecosystem</p>
      <div class="quad reveal" style="margin-top:32px;">
        <a href="https://www.npmjs.com/package/@lcdd/core" class="feature" style="text-decoration:none;color:inherit;">
          <h4>@lcdd/core</h4>
          <p>SDK — Context model, schema, registry, CQL parser, verifier.</p>
        </a>
        <a href="https://www.npmjs.com/package/@lcdd/cli" class="feature" style="text-decoration:none;color:inherit;">
          <h4>@lcdd/cli</h4>
          <p>CLI — init, context, validate, query, transition.</p>
        </a>
        <div class="feature">
          <h4>Specification</h4>
          <p>17 RFC-style docs covering lifecycle, authority, governance, schema.</p>
        </div>
        <div class="feature">
          <h4>Context Packs</h4>
          <p>5 domains — Startup, Fintech, Healthcare, E-commerce, Hackathon.</p>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-inner">
        <div>
          <div class="footer-name">Living Context Driven Development</div>
          <div class="footer-meta">v0.2.1 &middot; Apache 2.0</div>
        </div>
        <div class="footer-links">
          <a href="https://github.com/Lelianto/living-context-driven-development">GitHub</a>
          <a href="https://www.npmjs.com/package/@lcdd/cli">npm</a>
          <a href="https://github.com/Lelianto/living-context-driven-development/blob/main/lcdd-methodology.md">Methodology</a>
          <a href="https://github.com/Lelianto/living-context-driven-development/tree/main/specification">Specification</a>
        </div>
      </div>
    </div>
  </footer>
</Base>

<script>
  const steps = [
    { num: '01', name: 'Discover', desc: 'Monitor regulatory websites, docs, Slack, GitHub, APIs.',
      detail: '<strong>Purpose:</strong> Identify potential sources of Contexts not yet in the Registry.<br/><br/><strong>Inputs:</strong> URLs of regulatory websites (GDPR, PCI-DSS, SOC 2, HIPAA), documentation repositories (Notion, Confluence), communication tools (Slack, Discord, Teams), meeting transcripts, incident postmortems, customer feedback channels, and AI-generated suggestions.<br/><br/><strong>Process:</strong> Each source is registered with URI, type, polling frequency, and ownership. Change detection monitors sources for new or updated content. Relevance filtering discards irrelevant changes using heuristics, keyword matching, and optional LLM-based scoring.<br/><br/><strong>Output:</strong> Candidate Source Items — pointers to raw material that may contain new or changed contexts.' },
    { num: '02', name: 'Extract', desc: 'LLM parses 200-page documents into candidates.',
      detail: '<strong>Purpose:</strong> Transform raw source material into structured candidate Contexts.<br/><br/><strong>Methods:</strong> LLM-based extraction (recommended for unstructured sources), regex/rule-based extraction for structured documents, or manual human annotation.<br/><br/><strong>Quality:</strong> Each candidate receives a confidence score (0.0–1.0). Target recall > 80%, precision > 70%. Source location is preserved (page number, paragraph) for provenance.<br/><br/><strong>Output:</strong> Extracted Candidate Contexts with confidence scores and source backlinks.' },
    { num: '03', name: 'Normalize', desc: 'Map to unified schema. De-duplicate. Validate.',
      detail: '<strong>Purpose:</strong> Map extracted candidates to the LCDD Context Schema, resolving format differences while preserving provenance.<br/><br/><strong>Process:</strong> Schema mapping of each field, ID generation (UUID v4 or human-readable slug), default application for unpopulated optional fields, JSON Schema validation, and deduplication against existing Draft/Candidate/Active contexts.<br/><br/><strong>Output:</strong> Normalized Contexts — valid against the Context Schema, in Draft lifecycle stage.' },
    { num: '04', name: 'Classify', desc: 'Assign authority, lifecycle, severity, scope.',
      detail: '<strong>Purpose:</strong> Assign lifecycle stage, authority level, governance classification, domain tags, and enforcement mode.<br/><br/><strong>Automated rules:</strong> Standard-body source → level 4 (Mandate), internal organization policy → level 3 (Standard), AI-extracted with low confidence → level 0 (Suggestion). Domain tagging via content analysis. All automated classifications are provisional — human reviewers can override.<br/><br/><strong>Output:</strong> Classified Contexts with populated authority, governance, tags, and severity.' },
    { num: '05', name: 'Review', desc: 'Human or automated review by classification.',
      detail: '<strong>Purpose:</strong> Human and/or automated review of classified contexts before they become enforceable.<br/><br/><strong>Routing:</strong> Contexts routed by domain tags (→ domain experts), authority level (→ approval chain), and source (→ source owner).<br/><br/><strong>Checklist:</strong> Is the constraint correct? Is the authority appropriate? Is the scope correct? Does it conflict with existing Active contexts? Is it enforceable? Is the description clear for both humans and AI agents?<br/><br/><strong>Auto-review:</strong> Local-Guideline and Local-Experimental contexts with high extraction confidence (> 0.9) may be auto-approved.' },
    { num: '06', name: 'Version', desc: 'Commit immutable version. Audit trail.',
      detail: '<strong>Purpose:</strong> Commit the approved Context to the Registry with an immutable version number.<br/><br/><strong>Process:</strong> Final schema validation, conflict detection against existing Active contexts, version assignment (version 1 for new, current + 1 for updates), immutable commit to the Registry, event emission.<br/><br/><strong>Output:</strong> Versioned Context in the Registry — immutable, auditable, with complete event log.' },
    { num: '07', name: 'Enforce', desc: 'CI, IDE, gateway, AI agent — pluggable.',
      detail: '<strong>Purpose:</strong> Consume Active contexts through enforcement plugins and report violations.<br/><br/><strong>Plugins:</strong> CI/CD pipeline (block merges), IDE (real-time violation highlighting), pre-commit hooks (fast local checks), API gateway (runtime validation), Terraform plan (infrastructure compliance), AI agent prompts (context injection).<br/><br/><strong>Modes:</strong> Block (prevents progression), Warn (visible warning), Comment (informational), Silent (tracked only). Mode determined by governance classification and lifecycle stage.' },
    { num: '08', name: 'Observe', desc: 'Violations, trends, AI vs human ratio.',
      detail: '<strong>Purpose:</strong> Collect and analyze enforcement outcomes to close the feedback loop.<br/><br/><strong>Metrics:</strong> Violation rate per context, violation trend, AI vs human violator ratio, context age vs violation rate, false positive ratio, time to compliance.<br/><br/><strong>Dashboards:</strong> Governance dashboard (CTO/CISO), team dashboard (engineering), agent dashboard (AI agent observability).<br/><br/><strong>Alerts:</strong> Violation spikes, AI violation anomalies, high false positive rates, stale contexts with zero violations.' },
    { num: '09', name: 'Improve', desc: 'Refine, deprecate. Close the feedback loop.',
      detail: '<strong>Purpose:</strong> Use observation data to drive context evolution.<br/><br/><strong>Triggers:</strong> Zero violations for 90 days → "Still needed?", increasing violation rate → "Enforcement clear?", high false positive rate → "Scope too broad?", new regulation detected → "New context needed?"<br/><br/><strong>Actions:</strong> Refinement (update context), deprecation (retire context), new context creation (back to Discover), governance reclassification (promote/demote Hardened ↔ Local).<br/><br/><strong>Governance:</strong> All changes follow the governance model — Hardened changes require explicit human approval, Local changes may auto-merge with observation period.' },
  ];

  const grid = document.getElementById('pipeline-grid');
  if (grid) {
    steps.forEach((s, i) => {
      const el = document.createElement('div');
      el.className = 'pipeline-step';
      el.style.animationDelay = `${i * 50}ms`;
      el.innerHTML = `<div class="num">${s.num}</div><div class="name">${s.name}</div><div class="desc">${s.desc}</div>`;
      el.addEventListener('click', () => openModal(i));
      grid.appendChild(el);
    });
  }

  const modal = document.getElementById('modal');
  const modalNum = document.getElementById('modal-num');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalDetail = document.getElementById('modal-detail');
  const modalClose = document.getElementById('modal-close');

  function openModal(i: number) {
    const s = steps[i];
    if (modalNum) modalNum.textContent = `Stage ${s.num}`;
    if (modalTitle) modalTitle.textContent = s.name;
    if (modalDesc) modalDesc.textContent = s.desc;
    if (modalDetail) modalDetail.innerHTML = s.detail;
    modal?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.remove('active');
    document.body.style.overflow = '';
  }

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Hamburger menu
  const hamburger = document.getElementById('nav-hamburger');
  const navLinks = document.getElementById('nav-links');
  hamburger?.addEventListener('click', () => {
    navLinks?.classList.toggle('open');
    hamburger.textContent = navLinks?.classList.contains('open') ? '\u2715' : '\u2630';
  });
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      if (hamburger) hamburger.textContent = '\u2630';
    });
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<style>
  @keyframes lcPulse {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>
